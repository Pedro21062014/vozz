 {
  "tipo": "frase",
  "texto": "Olá, tudo bem com você?",
  "esperado": "olˈa tˈudʊ bˈeɪŋ koŋ vosˈe"
 },
 {
  "tipo": "frase",
  "texto": "O rato roeu a roupa do rei de Roma.",
  "esperado": "ʊ xˈatʊ xoˈeʊ a xˈowpæ dʊ xˈeɪ dʒy xˈomæ"
 },
 {
  "tipo": "frase",
  "texto": "Hoje o dia está muito bonito aqui em São Paulo.",
  "esperado": "ˈoʒj ʊ dʒˈiæ estˌa mwˈiŋtʊ bˌonˈitw akˈi ˈeɪŋ sɐ̃ʊ̃ pˈaʊlʊ"
 },
 {
  "tipo": "frase",
  "texto": "Eu gosto de programar em JavaScript no navegador.",
  "esperado": "eʊ ɡˈɔstʊ dʒy prˌoɡræmˈaɾ ˈeɪŋ ʒˈavæ skrˈiptʃ nʊ nˌaveɡadˈor"
 },
 {
  "tipo": "frase",
  "texto": "A inteligência artificial mudou o mundo da tecnologia.",
  "esperado": "a ˌiŋteliʒˈeɪŋsjæ ˌaɾətʃifˌisiˈaʊ mudˈow ʊ mˈũŋdʊ da tˌeknoloʒˈiæ"
 },
 {
  "tipo": "frase",
  "texto": "Meu nome é Dora e eu falo português do Brasil.",
  "esperado": "meʊ nˈomj ɛ dˈɔɾæ i eʊ fˈalʊ pˌoɾətuɡˈez dʊ brazˈiʊ"
 },
 {
  "tipo": "frase",
  "texto": "Vamos almoçar juntos amanhã de manhã?",
  "esperado": "vˌɐ̃mʊz ˌaʊmosˈar ʒˈũŋtʊz ˌæmɐ̃ɲˈɐ̃ dʒy mɐ̃ɲˈɐ̃"
 },
 {
  "tipo": "frase",
  "texto": "O trabalho dele é muito importante para a empresa.",
  "esperado": "ʊ trˌabˈaljʊ dˌely ɛ mwˈiŋtw ˌimpoɾətˈɐ̃ŋtʃy pˌaɾæ a ˌeɪmprˈezæ"
 },
 {
  "tipo": "frase",
  "texto": "As crianças brincam felizes no parque da cidade.",
  "esperado": "as krˌiˈɐ̃ŋsæz brˈiŋkɐ̃ʊ̃ fˌelˈizyz nʊ pˈaɾəky da sˌidˈadʒy"
 },
 {
  "tipo": "frase",
  "texto": "Preciso comprar pão, leite e café no mercado.",
  "esperado": "prˌesˈizʊ komprˈar pˈɐ̃ʊ̃ lˈeɪtʃj i kafˈɛ nʊ mˌeɾəkˈadʊ"
 },
 {
  "tipo": "frase",
  "texto": "Ela trabalha como professora numa escola pública.",
  "esperado": "ˌɛlæ trˌabˈaljæ kˌomʊ prˌofesˈoɾæ nˌumæ ˌeskˈɔlæ pˈublikæ"
 },
 {
  "tipo": "frase",
  "texto": "Não consigo acreditar que já é sexta-feira!",
  "esperado": "nˌɐ̃ʊ̃ kˌoŋsˈiɡw ˌakredʒitˈar ky ʒˈa ɛ sˈestæfˈeɪɾæ"
 },
 {
  "tipo": "frase",
  "texto": "A música brasileira é conhecida no mundo inteiro.",
  "esperado": "a mˈuzikæ brˌazilˈeɪɾæ ɛ kˌoɲesˈidæ nʊ mˈũŋdw ˌiŋtˈeɪɾʊ"
 },
 {
  "tipo": "frase",
  "texto": "Você poderia me ajudar com esse problema, por favor?",
  "esperado": "vosˌe pˌodeɾˈiæ mj ˌaʒudˈar koŋ ˌesi prˌoblˈemæ por favˈor"
 },
 {
  "tipo": "frase",
  "texto": "O coração dela bateu forte naquele momento.",
  "esperado": "ʊ kˌoɾasˈɐ̃ʊ̃ dˌɛlæ batˈeʊ fˈɔɾətʃy nˌakˈely mˌomˈeɪŋtʊ"
 }
