{
  "name": "@pedrobef/vozz",
  "version": "0.1.4",
  "description": "TTS ultrarrealista em português do Brasil, 100% offline no navegador. Vozes neurais leves (~86 MB), sem API key, sem servidor, sem custo.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./g2p": {
      "types": "./types/g2p.d.ts",
      "default": "./src/g2p/index.js"
    },
    "./package.json": "./package.json",
    "./sintetizador": {
      "types": "./types/sintetizador.d.ts",
      "default": "./src/sintetizador.js"
    },
    "./piper": {
      "types": "./types/piper.d.ts",
      "default": "./src/piper.js"
    }
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE",
    "pages"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/*.test.js",
    "eval": "node scripts/eval-g2p.mjs",
    "demo": "node scripts/demo-node.mjs",
    "serve": "npx --yes serve examples -l 8080",
    "qualidade": "node scripts/qualidade.mjs",
    "calibrar": "node scripts/calibrar.mjs",
    "calibrar-vogais": "node scripts/calibrar-vogais.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "pages": "node scripts/build-pages.mjs && npx --yes serve dist-pages -l 8080"
  },
  "keywords": [
    "tts",
    "text-to-speech",
    "portugues",
    "portuguese",
    "pt-br",
    "brazilian-portuguese",
    "voz",
    "sintese-de-voz",
    "speech-synthesis",
    "kokoro",
    "onnx",
    "webgpu",
    "offline",
    "local",
    "browser",
    "neural",
    "g2p",
    "phonemizer",
    "ipa"
  ],
  "author": "Pedro Berbis Freire",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pedro21062014/vozz.git"
  },
  "homepage": "https://github.com/Pedro21062014/vozz#readme",
  "bugs": {
    "url": "https://github.com/Pedro21062014/vozz/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.1"
  },
  "peerDependencies": {
    "onnxruntime-web": ">=1.17.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-web": {
      "optional": true
    }
  }
}
